{
  "name": "@stampdwn/core",
  "version": "0.1.5",
  "description": "Stampdown is a Markdown templating language, that is simple and extensible.",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "browser": "./dist/client.js",
      "node": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "default": "./dist/plugins/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "api": "api-extractor run",
    "docs": "api-documenter markdown --input-folder ./temp --output-folder ./docs",
    "ai-docs": "mkdir -p ../../.github/api/core/ && cp ./docs/**.md ../../.github/api/core/ && python ../../scripts/flatten_docs.py ../../.github/api/core > ../../.github/api/core.md && rm -rf ../../.github/api/core/"
  },
  "keywords": [
    "markdown",
    "template",
    "templating",
    "handlebars",
    "expressions"
  ],
  "author": "Devon Anderson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ascot-Software/stampdown.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4"
  }
}
