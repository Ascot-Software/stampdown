{
  "name": "@stampdwn/cli",
  "version": "0.1.2",
  "description": "Command-line interface for Stampdown",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "stampdown": "./bin/stampdown.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "api": "api-extractor run",
    "docs": "api-documenter markdown --input-folder ./temp --output-folder ./docs",
    "ai-docs": "mkdir -p ../../.github/api/cli/ && cp ./docs/**.md ../../.github/api/cli/ && python ../../scripts/flatten_docs.py ../../.github/api/cli > ../../.github/api/cli.md && rm -rf ../../.github/api/cli/"
  },
  "keywords": [
    "markdown",
    "template",
    "cli",
    "stampdown"
  ],
  "author": "Devon Anderson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ascot-Software/stampdown.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stampdwn/core": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4"
  }
}
